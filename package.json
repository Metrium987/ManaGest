{
  "name": "managest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ManaGest — ERP de gestion pour la Polynésie française",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "npm run typecheck && vite build && npm run build:worker",
    "build:worker": "esbuild server/worker.ts --bundle --format=esm --platform=browser --main-fields=module,main --target=es2022 --outfile=dist/worker/index.js --external:node:*",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute managest-db --local --file=./server/db/migrations/0001_init.sql",
    "preview": "npm run build && wrangler dev --port 8787 --local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
